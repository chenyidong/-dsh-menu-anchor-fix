{
  "name": "dsh-menu-anchor-fix",
  "version": "0.1.0",
  "description": "Fix dsh-armory summon menu (技能/MCP/专家/本项目) drifting to the right: re-anchor its position:fixed coordinates to the trigger icon in viewport space.",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "armory", "menu", "position"],
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": [] }
  }
}
